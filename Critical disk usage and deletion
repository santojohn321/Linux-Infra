#!/bin/bash

echo
read -rp "Which Directory (/,/home,/var): " TARGET_DIR

if [ ! -d "$TARGET_DIR" ]; then
    echo "Directory does not exist."
    exit 1
fi

echo
echo "Top 20 Highest Usage Files in $TARGET_DIR"
echo "========================================="

find "$TARGET_DIR" -type f -exec du -h {} + 2>/dev/null \
    | sort -hr \
    | head -20

echo
read -rp "Filename for deletion from above: " FILE

if [ -z "$FILE" ]; then
    echo "No file specified."
    exit 0
fi

if [ ! -f "$FILE" ]; then
    echo "File not found: $FILE"
    exit 1
fi

echo
echo "File Details:"
ls -lh "$FILE"

echo
read -rp "Delete this file? (y/n): " CONFIRM

if [[ "$CONFIRM" =~ ^[Yy]$ ]]; then
    rm -f "$FILE"
    echo "Deleted: $FILE"
else
    echo "Deletion cancelled."
fi
