#!/bin/bash
# builtservice_cleanup.sh
# Finds and deletes builtservice.zip files under the agent work directory,
# logging deletions and a summary report.

LOG_FILE="/var/log/builtservice_cleanup.log"
DELETED_COUNT=0
FREED_SPACE=0

{
    echo
    echo "Run Started: $(date)"
} >> "$LOG_FILE"

while IFS= read -r FILE
do
    if [ -f "$FILE" ]; then
        SIZE=$(stat -c%s "$FILE" 2>/dev/null || echo 0)
        if rm -f "$FILE"; then
            echo "Deleted : $FILE" >> "$LOG_FILE"
            DELETED_COUNT=$((DELETED_COUNT + 1))
            FREED_SPACE=$((FREED_SPACE + SIZE))
        else
            echo "FAILED  : $FILE" >> "$LOG_FILE"
        fi
    fi
done < <(
    find /home/admszhang/myagent/_work \
        -type f \
        -name "builtservice.zip" \
        -mmin +60
)

{
    echo
    echo "Summary"
    echo "-------"
    echo "Files deleted : $DELETED_COUNT"
    echo "Space freed   : $(numfmt --to=iec "$FREED_SPACE" 2>/dev/null || echo "$FREED_SPACE bytes")"
    echo
    echo "Largest Remaining Files"
    echo "-----------------------"
    find /home/admszhang/myagent/_work -type f -exec du -h {} + 2>/dev/null \
        | sort -hr \
        | head -20
    echo
    echo "Report Finished: $(date)"
} >> "$LOG_FILE"
